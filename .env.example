# Copy to .env for local use. Never commit .env or real secrets.

PROJECT_SLUG=scalping-briefing
TIMEZONE=Asia/Seoul
WEEKLY_REPORT_SCHEDULE="TUE 08:00,FRI 08:00"
INITIAL_LOOKBACK_DAYS=14
MAX_LOOKBACK_DAYS=30
CANDIDATE_SCORE_THRESHOLD=60
BRIEFING_MAX_ITEMS=7
EXTRACTION_CONFIDENCE_MIN=0.7
QUOTE_MAX_CHARS=300
BRIEFING_LANGUAGE=ko
PUBLICATION_POLICY=manual_approval
DELIVERY_CHANNEL=telegram
DELIVERY_MODE=dry_run
# Local LLM mode reference (intent-docs/scalping_local_llm_extraction_intent.md §3.2):
# LLM_MODE=live requires LLM_MONTHLY_BUDGET_USD and LLM_RUN_MAX_TOKENS to be set
# (see config.py _validate(), ~L250-255), and one of the approval aliases:
# llm_live, live_llm, llm_mode_live, llm, live. Actual switch to LLM_MODE=live is
# NOT enabled by this file alone — requires separate operator approval.
LLM_MODE=fixture
# Local inference (Ollama) has no API billing, so setting this to 0 satisfies
# _validate()'s check (must be non-None and >= 0) without implying real spend.
LLM_MONTHLY_BUDGET_USD=
# Runaway-generation cap. If set (e.g. 2000), this value must match the
# num_predict option that LocalLLMClient (src/scalping_briefing/llm/local_ollama.py)
# passes to Ollama, or the two will drift out of sync.
LLM_RUN_MAX_TOKENS=
DATABASE_URL=sqlite:///./data/app.sqlite3
REVIEW_API_BIND=127.0.0.1
REVIEW_API_TOKEN=
MAX_COLLECT_RETRIES=3
RESPONSE_MAX_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=20
MAX_REDIRECTS=3
RAW_RETENTION_DAYS=365
NORMALIZED_RETENTION_DAYS=unlimited
LLM_RUN_RETENTION_DAYS=365
ALERTS_DIR=alerts/
