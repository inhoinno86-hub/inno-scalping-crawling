{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalping-briefing.local/schema/briefing.json",
  "title": "Publishable Briefing",
  "$comment": "Publishing contract references docs/notices.md. This contract intentionally contains metadata, summaries, and bounded evidence only; it has no original-document full-text field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["briefing_id", "scheduled_for", "trigger_type", "run_attempt", "window_start", "window_end", "window_truncated", "run_status", "publication_status", "generated_at", "timezone", "items", "notices"],
  "properties": {
    "briefing_id": {"type": "string", "minLength": 1},
    "scheduled_for": {"type": "string", "format": "date-time"},
    "trigger_type": {"type": "string", "enum": ["scheduled", "manual"]},
    "run_attempt": {"type": "integer", "minimum": 1},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "window_truncated": {"type": "boolean"},
    "run_status": {"type": "string", "enum": ["pending", "running", "success", "failed"]},
    "publication_status": {"type": "string", "enum": ["draft", "pending_approval", "approved", "rejected", "published", "archived"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "shared_at": {"type": ["string", "null"], "format": "date-time"},
    "timezone": {"type": "string", "minLength": 1},
    "markdown_location": {"type": ["string", "null"]},
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "success": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "not_run": {"type": "integer", "minimum": 0}
      }
    },
    "candidate_count": {"type": "integer", "minimum": 0},
    "approved_count": {"type": "integer", "minimum": 0},
    "items_truncated": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["briefing_item_id", "briefing_id", "reason_included", "rank", "carried_over", "evidence"],
        "properties": {
          "briefing_item_id": {"type": "string", "minLength": 1},
          "briefing_id": {"type": "string", "minLength": 1},
          "strategy_candidate_id": {"type": "string", "minLength": 1},
          "strategy_id": {"type": "string", "minLength": 1},
          "reason_included": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 1},
          "carried_over": {"type": "boolean"},
          "canonical_name": {"type": "string"},
          "summary": {"type": "string"},
          "asset_classes": {"type": "array", "items": {"type": "string"}},
          "strategy_families": {"type": "array", "items": {"type": "string"}},
          "holding_horizon": {"type": "string"},
          "value_score": {"type": "number", "minimum": 0, "maximum": 100},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_id", "document_version_id", "quote"],
              "properties": {
                "evidence_id": {"type": "string", "minLength": 1},
                "document_version_id": {"type": "string", "minLength": 1},
                "strategy_candidate_id": {"type": "string", "minLength": 1},
                "quote": {"type": "string", "minLength": 1, "maxLength": 300},
                "field_name": {"type": "string"},
                "section_or_locator": {"type": "string"},
                "source_url": {"type": "string", "format": "uri"},
                "captured_at": {"type": "string", "format": "date-time"}
              }
            }
          }
        },
        "anyOf": [
          {"required": ["strategy_candidate_id"]},
          {"required": ["strategy_id"]}
        ]
      }
    },
    "notices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safety", "copyright", "investment"],
      "properties": {
        "safety": {"type": "string", "minLength": 1},
        "copyright": {"type": "string", "minLength": 1},
        "investment": {"type": "string", "minLength": 1}
      }
    }
  }
}
