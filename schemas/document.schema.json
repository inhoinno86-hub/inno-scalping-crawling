{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalping-briefing.local/schema/document.json",
  "title": "Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "source_id",
    "canonical_url",
    "title",
    "author_or_org",
    "published_at",
    "language",
    "document_type",
    "robots_allowed",
    "robots_rule_matched",
    "robots_evaluated_at",
    "access_decision_reason",
    "collection_status",
    "processing_status",
    "access_status",
    "license"
  ],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "minLength": 1, "format": "uri"},
    "original_url": {"type": "string", "minLength": 1, "format": "uri"},
    "title": {"type": "string", "minLength": 1},
    "author_or_org": {"type": "string"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "language": {"type": "string", "minLength": 2},
    "document_type": {"type": "string", "minLength": 1},
    "robots_allowed": {"type": ["boolean", "string"], "enum": [true, false, "unknown"]},
    "robots_rule_matched": {"type": ["string", "null"]},
    "robots_evaluated_at": {"type": ["string", "null"], "format": "date-time"},
    "access_decision_reason": {"type": "string", "minLength": 1},
    "collection_status": {"type": "string", "enum": ["discovered", "collected", "failed", "access_denied"]},
    "processing_status": {"type": "string", "enum": ["discovered", "collected", "normalized", "deduplicated", "classified", "extracted", "validated", "needs_review", "approved", "rejected", "archived", "duplicate", "irrelevant", "background_only", "access_denied", "failed"]},
    "access_status": {"type": "string", "enum": ["allowed", "denied", "unknown"]},
    "license": {"type": ["string", "null"]},
    "content_hash": {"type": ["string", "null"]},
    "source_version_ref": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  }
}
