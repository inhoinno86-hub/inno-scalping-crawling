{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalping-briefing.local/schema/briefing-item.json",
  "title": "Briefing Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["briefing_item_id", "briefing_id", "reason_included", "rank", "carried_over", "evidence"],
  "properties": {
    "briefing_item_id": {"type": "string", "minLength": 1},
    "briefing_id": {"type": "string", "minLength": 1},
    "strategy_candidate_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "reason_included": {"type": "string", "minLength": 1},
    "rank": {"type": "integer", "minimum": 1},
    "carried_over": {"type": "boolean"},
    "canonical_name": {"type": "string"},
    "summary": {"type": "string"},
    "asset_classes": {"type": "array", "items": {"type": "string"}},
    "strategy_families": {"type": "array", "items": {"type": "string"}},
    "holding_horizon": {"type": "string"},
    "value_score": {"type": "number", "minimum": 0, "maximum": 100},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "document_version_id", "quote"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "document_version_id": {"type": "string", "minLength": 1},
          "strategy_candidate_id": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1, "maxLength": 300},
          "field_name": {"type": "string"},
          "section_or_locator": {"type": "string"},
          "source_url": {"type": "string", "format": "uri"},
          "captured_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "anyOf": [
    {"required": ["strategy_candidate_id"]},
    {"required": ["strategy_id"]}
  ]
}
