{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalping-briefing.local/schema/document-version.json",
  "title": "Document Version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_version_id",
    "document_id",
    "retrieved_at",
    "content_hash",
    "body_hash",
    "source_version_ref",
    "raw_location",
    "normalized_location",
    "change_summary",
    "collection_status",
    "processing_status",
    "access_status",
    "license",
    "robots_allowed",
    "robots_rule_matched",
    "robots_evaluated_at",
    "access_decision_reason"
  ],
  "properties": {
    "document_version_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "minLength": 1},
    "body_hash": {"type": ["string", "null"]},
    "source_version_ref": {"type": ["string", "null"]},
    "raw_location": {"type": ["string", "null"]},
    "normalized_location": {"type": ["string", "null"]},
    "change_summary": {"type": "string"},
    "collection_status": {"type": "string", "enum": ["discovered", "collected", "failed", "access_denied"]},
    "processing_status": {"type": "string", "enum": ["discovered", "collected", "normalized", "deduplicated", "classified", "extracted", "validated", "needs_review", "approved", "rejected", "archived", "duplicate", "irrelevant", "background_only", "access_denied", "failed"]},
    "access_status": {"type": "string", "enum": ["allowed", "denied", "unknown"]},
    "license": {"type": ["string", "null"]},
    "robots_allowed": {"type": ["boolean", "string"], "enum": [true, false, "unknown"]},
    "robots_rule_matched": {"type": ["string", "null"]},
    "robots_evaluated_at": {"type": ["string", "null"], "format": "date-time"},
    "access_decision_reason": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  }
}
